rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entities ---

    // Stations: Public read
    match /stations/{stationId} {
      allow get: if isValidId(stationId);
      allow list: if true;
    }

    // Trains: Public read
    match /trains/{trainNumber} {
      allow get: if isValidId(trainNumber);
      allow list: if true;
    }

    // Pings: Signed-in write, public read for crowdsourced info
    match /pings/{pingId} {
      allow get: if isValidId(pingId);
      allow list: if true;

      function isValidPing(data) {
        return data.trainId is string && data.trainId.size() <= 32 &&
               data.stationId is string && data.stationId.size() <= 32 &&
               data.platform is string && data.platform.size() <= 10 &&
               data.reportedBy == request.auth.uid &&
               data.confirmedBy is list &&
               data.createdAt == request.time &&
               data.expiresAt is timestamp;
      }

      allow create: if isSignedIn() && 
                    isValidId(pingId) && 
                    isValidPing(incoming()) && 
                    incoming().confirmedBy.size() == 0;

      allow update: if isSignedIn() && (
        // Action: Confirm a ping (add self to list)
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['confirmedBy']) &&
          incoming().confirmedBy.size() == existing().confirmedBy.size() + 1 &&
          incoming().confirmedBy.hasAll(existing().confirmedBy) &&
          request.auth.uid in incoming().confirmedBy &&
          !(request.auth.uid in existing().confirmedBy)
        )
      );
      
      allow delete: if false;
    }

    // Delays: Crowdsourced delay reports
    match /delays/{delayId} {
      allow get: if isValidId(delayId);
      allow list: if true;

      function isValidDelay(data) {
        return data.trainId is string && data.trainId.size() <= 32 &&
               data.minutes is number && data.minutes >= 0 && data.minutes <= 1440 &&
               data.reportedBy == request.auth.uid &&
               data.createdAt == request.time &&
               (!('reason' in data) || (data.reason is string && data.reason.size() <= 200));
      }

      allow create: if isSignedIn() && 
                    isValidId(delayId) && 
                    isValidDelay(incoming());
      
      allow update, delete: if false;
    }

    // Availability: Crowdsourced coach seat availability
    match /availability/{reportId} {
      allow get: if isValidId(reportId);
      allow list: if true;

      function isValidAvailability(data) {
        return data.trainId is string && data.trainId.size() <= 32 &&
               data.coachId is string && data.coachId.size() <= 32 &&
               data.status in ['empty', 'moderate', 'full'] &&
               data.reportedBy == request.auth.uid &&
               data.createdAt == request.time;
      }

      allow create: if isSignedIn() && 
                    isValidId(reportId) && 
                    isValidAvailability(incoming());
      
      allow update, delete: if false;
    }

    // Live Positions: Crowdsourced real-time coordinates
    match /live_positions/{posId} {
      allow get: if isValidId(posId);
      allow list: if true;

      function isValidLivePosition(data) {
        return data.trainId is string && data.trainId.size() <= 32 &&
               data.latitude is number && data.latitude >= -90 && data.latitude <= 90 &&
               data.longitude is number && data.longitude >= -180 && data.longitude <= 180 &&
               data.reportedBy == request.auth.uid &&
               data.createdAt == request.time;
      }

      allow create: if isSignedIn() && 
                    isValidId(posId) && 
                    isValidLivePosition(incoming());
      
      allow update, delete: if false;
    }
  }
}
